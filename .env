# ==============================================================================
# GroundTruth Production Environment Configuration
# ==============================================================================

# AWS Region & Account Config
AWS_REGION=us-east-1
APP_ENV=production

# Storage (Amazon S3)
# S3 bucket for policy documents, evidence images, and remediation photos
S3_BUCKET=groundtruth-evidence-vault-prod-573086082815
MAX_UPLOAD_SIZE_MB=25
PRESIGNED_URL_EXPIRES_IN_SEC=900

# Database (Amazon DynamoDB)
# Table prefix for findings and audit log tables
DYNAMODB_PREFIX=groundtruth_
DYNAMODB_FINDINGS_TABLE=groundtruth_findings_prod
DYNAMODB_AUDIT_TABLE=groundtruth_audit_log_prod

# Authentication (Amazon Cognito)
COGNITO_USER_POOL_ID=us-east-1_YEPtHgZVf
COGNITO_CLIENT_ID=5mvs2cl4ic2mscrjg9or83iv3l
AUTH_COOKIE_NAME=gt_session_token

# AI / ML (Amazon SageMaker AI)
# Endpoint name for the PyTorch Vision Reasoner model
SAGEMAKER_ENDPOINT_NAME=groundtruth-vision-reasoner-prod
SAGEMAKER_ROLE_ARN=arn:aws:iam::573086082815:role/groundtruth-vision-reasoner-prod-exec-role
# AI Provider: 'sagemaker' for real AWS endpoint, 'demo' for deterministic offline fallback
AI_PROVIDER=sagemaker

# API Layer (Amazon API Gateway)
API_GATEWAY_URL=https://qfbxx6uu7k.execute-api.us-east-1.amazonaws.com
PORT=3001

# Eventing & Workflow (AWS Step Functions, EventBridge, SQS, SNS)
EVENT_BUS_NAME=groundtruth-domain-events-prod
INSPECTION_QUEUE_NAME=groundtruth-inspection-jobs-prod.fifo
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:573086082815:groundtruth-critical-reality-gaps-prod
STEP_FUNCTIONS_STATE_MACHINE_ARN=arn:aws:states:us-east-1:573086082815:stateMachine:GroundTruth-Inspection-Pipeline

# Frontend Hosting (Amazon Amplify)
AMPLIFY_APP_ID=d2groundtruthapp
VITE_API_BASE_URL=/api/v1
